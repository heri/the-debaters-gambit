# ── Front-end ─────────────────────────────────────────────────────────────────

# Dependencies
front-end/node_modules/

# Expo / Metro
front-end/.expo/
front-end/.expo-shared/
front-end/.metro-cache/

# Build output
front-end/dist/
front-end/web-build/
front-end/android/
front-end/ios/
front-end/*.jsbundle

# Test coverage
front-end/coverage/

# Environment files — never commit secrets or API keys
front-end/.env
front-end/.env.*
front-end/.env*.local

# Firebase / Google service configs (contain API keys)
front-end/google-services.json
front-end/GoogleService-Info.plist

# ── Back-end ──────────────────────────────────────────────────────────────────

# Build artefacts
back-end/_build/
back-end/deps/
back-end/cover/
back-end/doc/
back-end/tmp/
back-end/.fetch
back-end/erl_crash.dump
back-end/*.ez
back-end/debater_gambit-*.tar

# SQLite databases (dev + test)
back-end/*.db
back-end/*.db-shm
back-end/*.db-wal

# Phoenix generated secrets (never commit these)
back-end/config/prod.secret.exs
back-end/config/releases.exs

# Back-end env file (if ever added for local secrets)
back-end/.env

# ── Secrets and credentials ───────────────────────────────────────────────────

# SSL / TLS certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.cer
*.mobileprovision
*.provisionprofile

# Generic secrets
*.secret
.secrets/
secrets/
credentials/

# ── Logs ──────────────────────────────────────────────────────────────────────

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / system ───────────────────────────────────────────────────────────────

# macOS
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editor ────────────────────────────────────────────────────────────────────

.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.cursor/

# ── AI / tooling ──────────────────────────────────────────────────────────────

# Claude Code memory (user-specific, not project config)
.claude/
